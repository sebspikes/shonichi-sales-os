#!/usr/bin/env python3
"""Shonichi Sales OS scoreboard.

Reads logs/<founder>/YYYY-MM-DD.md (the fixed machine-countable format) and renders
the scoreboard. Logs are the canonical count source; Airtable adds live funnel
detail in-session (reply rates per template belong to the Sunday review, not here).

Usage:
  tools/scoreboard                    render scoreboard/README.md and print it
  tools/scoreboard --ping <founder>   compose today's Slack one-liner for <founder>
                                      and POST it to $SLACK_WEBHOOK_URL
                                      (no URL set -> print payload, exit 2: dry run)
  tools/scoreboard --ping <founder> --date YYYY-MM-DD   ping for a specific log date

Rules (S9 decisions, 15 Sept 2026, Seb; Sotirios to ratify on return):
  - Quality touches win the week; replies break ties. Stakes: loser buys coffee.
  - Streak = consecutive weekdays with a logged session. Weekend logs extend a
    streak but missing a weekend never breaks one. A missed weekday breaks it.
  - Weekly target: 25 quality touches per founder (from 5 Oct; shown always).
"""

import json
import os
import re
import sys
import urllib.request
from datetime import date, datetime, timedelta
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
LOGS = REPO / "logs"
OUT = REPO / "scoreboard" / "README.md"
FOUNDERS = ["seb", "sotirios"]
TARGET = 25
NUMERIC = ["touches", "replies", "demos", "pulses"]


def parse_log(path):
    """Parse one log file into a dict; tolerate stray whitespace, reject junk."""
    entry = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        m = re.match(r"^(\w[\w ]*?):\s*(.*)$", line.strip())
        if m:
            entry[m.group(1).lower()] = m.group(2).strip()
    try:
        entry["date"] = datetime.strptime(entry.get("date", path.stem), "%Y-%m-%d").date()
    except ValueError:
        return None
    for k in NUMERIC:
        try:
            entry[k] = int(entry.get(k, 0) or 0)
        except ValueError:
            entry[k] = 0
    return entry


def load_logs():
    logs = {f: [] for f in FOUNDERS}
    for founder in FOUNDERS:
        d = LOGS / founder
        if not d.is_dir():
            continue
        for p in sorted(d.glob("*-*-*.md")):
            e = parse_log(p)
            if e:
                logs[founder].append(e)
    return logs


def week_start(d):
    return d - timedelta(days=d.weekday())  # Monday


def week_totals(entries, monday):
    t = {k: 0 for k in NUMERIC}
    for e in entries:
        if monday <= e["date"] < monday + timedelta(days=7):
            for k in NUMERIC:
                t[k] += e[k]
    return t


def day_streak(entries, today):
    """Consecutive weekdays with a log, counting back from today.
    Weekends: a log extends the chain, no log is neutral. Today without a log
    yet does not break the streak (the session may not be logged yet)."""
    logged = {e["date"] for e in entries}
    streak = 0
    d = today
    first = True
    while True:
        if d in logged:
            streak += 1
        elif d.weekday() < 5:  # weekday with no log
            if not first:
                break
            # today itself not yet logged: skip, keep counting back
        d -= timedelta(days=1)
        first = False
        if d < date(2026, 9, 1):
            break
    return streak


def head_to_head(logs, today):
    """Past completed weeks with any activity: who won on touches, replies tiebreak."""
    wins = {f: 0 for f in FOUNDERS}
    draws = 0
    all_dates = [e["date"] for f in FOUNDERS for e in logs[f]]
    if not all_dates:
        return wins, draws
    w = week_start(min(all_dates))
    this_monday = week_start(today)
    while w < this_monday:
        totals = {f: week_totals(logs[f], w) for f in FOUNDERS}
        if any(any(t.values()) for t in totals.values()):
            a, b = (totals[f] for f in FOUNDERS)
            key_a = (a["touches"], a["replies"])
            key_b = (b["touches"], b["replies"])
            if key_a > key_b:
                wins["seb"] += 1
            elif key_b > key_a:
                wins["sotirios"] += 1
            else:
                draws += 1
        w += timedelta(days=7)
    return wins, draws


def render(logs, today):
    monday = week_start(today)
    lines = [
        "# Scoreboard",
        "",
        f"Generated by `tools/scoreboard` on {today.isoformat()}. "
        f"Week of {monday.isoformat()} (Mon). Target: {TARGET} quality touches per founder per week.",
        "",
        "| | Seb | Sotirios |",
        "|---|---|---|",
    ]
    week = {f: week_totals(logs[f], monday) for f in FOUNDERS}
    for k in NUMERIC:
        lines.append(f"| {k.capitalize()} (this week) | {week['seb'][k]} | {week['sotirios'][k]} |")
    lines.append(
        f"| vs target {TARGET} | {week['seb']['touches'] - TARGET:+d} | {week['sotirios']['touches'] - TARGET:+d} |"
    )
    streaks = {f: day_streak(logs[f], today) for f in FOUNDERS}
    lines.append(f"| Session-day streak | {streaks['seb']} | {streaks['sotirios']} |")
    alltime = {f: {k: sum(e[k] for e in logs[f]) for k in NUMERIC} for f in FOUNDERS}
    for k in NUMERIC:
        lines.append(f"| {k.capitalize()} (all time) | {alltime['seb'][k]} | {alltime['sotirios'][k]} |")
    lines.append(f"| Sessions logged | {len(logs['seb'])} | {len(logs['sotirios'])} |")
    wins, draws = head_to_head(logs, today)
    lines += [
        "",
        f"**Head-to-head (completed weeks):** Seb {wins['seb']} - {wins['sotirios']} Sotirios"
        + (f" ({draws} drawn)" if draws else ""),
        "",
        "Rules: quality touches win the week, replies break ties; loser buys coffee. "
        "Streak counts consecutive weekdays with a logged session (weekends extend, never break). "
        "Drafts do not count: a touch exists when `Sent` is filled in Airtable and the log says so.",
    ]
    return "\n".join(lines) + "\n"


def compose_ping(logs, founder, ping_date):
    entry = next((e for e in logs[founder] if e["date"] == ping_date), None)
    if entry is None:
        sys.exit(f"No log for {founder} on {ping_date.isoformat()} — write the log first, then ping.")
    week = {f: week_totals(logs[f], week_start(ping_date)) for f in FOUNDERS}
    return (
        f"{founder.capitalize()}: {entry['touches']} touches, {entry['replies']} replies, "
        f"{entry['pulses']} pulses today. "
        f"Week: Seb {week['seb']['touches']} vs Sotirios {week['sotirios']['touches']} (target {TARGET})."
    )


def send_ping(text):
    url = os.environ.get("SLACK_WEBHOOK_URL", "").strip()
    payload = json.dumps({"text": text})
    if not url:
        print("DRY RUN — SLACK_WEBHOOK_URL not set. Payload that would post to #sales-os:")
        print(payload)
        sys.exit(2)
    req = urllib.request.Request(
        url, data=payload.encode(), headers={"Content-Type": "application/json"}
    )
    with urllib.request.urlopen(req, timeout=15) as resp:
        body = resp.read().decode(errors="replace")
        if resp.status != 200 or body.strip() != "ok":
            sys.exit(f"Slack webhook answered {resp.status}: {body[:200]}")
    print(f"Pinged #sales-os: {text}")


def main(argv):
    logs = load_logs()
    today = date.today()
    if "--ping" in argv:
        founder = argv[argv.index("--ping") + 1].lower()
        if founder not in FOUNDERS:
            sys.exit(f"founder must be one of {FOUNDERS}")
        ping_date = today
        if "--date" in argv:
            ping_date = datetime.strptime(argv[argv.index("--date") + 1], "%Y-%m-%d").date()
        send_ping(compose_ping(logs, founder, ping_date))
        return
    out = render(logs, today)
    OUT.parent.mkdir(exist_ok=True)
    OUT.write_text(out, encoding="utf-8")
    print(out, end="")


if __name__ == "__main__":
    main(sys.argv[1:])
